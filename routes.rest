// LOCALHOST
### Get all students
GET http://localhost:8080/students/

### Get students by ID
GET http://localhost:8080/students/6ab3e1b5d4fbdb80ed79fc13
### Create students
POST http://localhost:8080/students/ HTTP/1.1
Content-Type: application/json

{
  "firstName": "Noah",
  "lastName": "Reyes",
  "email": "test1@example.com",
  "birthday": "2002-11-03T00:00:00.000Z",
  "address": "45 Rizal Ave, Manila",
  "contactNumber": "+63 918 555 0102",
  "section": "A"
}

### Put Students
PUT http://localhost:8080/students/6ab3e1b5d4fbdb80ed79fc13 HTTP/1.1
Content-Type: application/json

 {
  "firstName": "Noah",
  "lastName": "Reyes Moore",
  "email": "test1@example.com",
  "birthday": "2002-11-03T00:00:00.000Z",
  "address": "45 Rizal Ave, Manila",
  "contactNumber": "+63 918 555 0102",
  "section": "A"
 }

### Delete students
DELETE http://localhost:8080/students/6ab3e1b5d4fbdb80ed79fc13


// ========== COURSES ==========

### Get all courses
GET http://localhost:8080/courses/

### Get course by ID
GET http://localhost:8080/courses/6ab5928cfe6f41515ae2fa59

### Create course
POST http://localhost:8080/courses/ HTTP/1.1
Content-Type: application/json

{
  "courseCode": "CSE210",
  "courseName": "Programming with Classes",
  "instructor": "Brother Taylor",
  "credits": 2,
  "semester": "Winter 2027"
}

### Update course
PUT http://localhost:8080/courses/6ab5928cfe6f41515ae2fa5b HTTP/1.1
Content-Type: application/json

{
  "courseCode": "WDD330",
  "courseName": "Web Frontend Development II",
  "instructor": "Sister Garcia",
  "credits": 3,
  "semester": "Winter 2027"
}

### Delete course (paste the courseId from "Create course" here)
DELETE http://localhost:8080/courses/6ab5967b5443b9b963575948

